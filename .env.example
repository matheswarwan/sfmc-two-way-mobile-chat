# Mode: `mock` runs entirely in-process with no SFMC calls. `live` talks to a tenant.
SFMC_MODE=mock
PORT=3000

# From the Installed Package's API Integration component.
SFMC_SUBDOMAIN=
SFMC_CLIENT_ID=
SFMC_CLIENT_SECRET=

# Business unit MID. Optional. Omit to use the package's own business unit.
SFMC_ACCOUNT_ID=

# The short or long code your contacts subscribed on. Procured via your
# Salesforce Account Executive; this is the only messaging value you must supply.
SFMC_SHORT_CODE=
# Two-letter country code. Required for SHORT codes (e.g. US).
# Leave BLANK for long codes, which carry their own country code in the number.
SFMC_COUNTRY_CODE=

# These are created for you from the setup screen at /#setup.
SFMC_KEYWORD=CHAT
SFMC_DEFINITION_KEY=sfmc-chat-outbound
SFMC_INBOUND_DE_KEY=ChatInbound

# Shared secret the AMPscript webhook presents as x-chat-secret.
INBOUND_WEBHOOK_SECRET=change-me

# How often to read the inbound Data Extension.
POLL_INTERVAL_MS=5000

# Must be registered on the Installed Package. Use 127.0.0.1, not localhost.
REDIRECT_URI=https://127.0.0.1:3000/auth/callback

# --- Delivery receipts (Event Notification Service), optional ---
# Public HTTPS URL of this server's /ens/callback route. No port, no query string,
# so a tunnel or deployed host is required. Without it, sent messages stay "Queued".
ENS_CALLBACK_URL=
ENS_CALLBACK_NAME=sfmc-chat-delivery
ENS_SUBSCRIPTION_NAME=sfmc-chat-sms-delivery

# Which API carries outbound messages: transactional (API-provisioned definition)
# or mobileconnect (hand-built Outbound message). Delivery receipts only fire on
# transactional. Defaults to mobileconnect when SFMC_SMS_MESSAGE_DEFINITION is set.
SFMC_OUTBOUND_TRANSPORT=
